# Point d'entrée Flask et port local pour la démonstration.
FLASK_APP=app.wsgi:app
APP_PORT=5000

# Cle API Claude, utilisee par /chat pour transformer la question en operation structuree.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Chemin du fichier SQLite (relatif au conteneur ou au dossier du projet en local).
DATABASE_PATH=data/data.db

# Active /test/operations, un panneau de démo pour désactiver une opération de
# verify_expenses et vérifier le refus propre côté agent. Reste à 0 en production.
ENABLE_TEST_CONTROLS=0

# Chemin du journal d'exécution horodaté (palier 4). Par défaut, place a cote
# de DATABASE_PATH, donc pas besoin de le definir separement.
# EXECUTION_LOG_PATH=data/execution.log

# Dossier des poids locaux de modération, provisionné une fois avec
# python scripts/prepare_moderation.py. Par défaut : .local_models/moderation.
# Aucun téléchargement de modèle pendant une requête.
# MODERATION_MODEL_DIR=/chemin/local/moderation
